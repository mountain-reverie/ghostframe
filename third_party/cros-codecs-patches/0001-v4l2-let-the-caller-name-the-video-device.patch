+
+    /// Open a specific video device rather than scanning for one.
+    ///
+    /// `None` keeps the scanning behaviour of [`Self::new`]. Prefer a path when
+    /// the caller knows which node decodes the codec it wants: the scan cannot
+    /// tell a decoder from an encoder, and node numbering is not stable across
+    /// boots.
+    pub fn new_with_device_path(
+        video_device_path: Option<PathBuf>,
+    ) -> Result<Self, NewStatelessDecoderError> {
+        Ok(Self { handle: Rc::new(RefCell::new(DeviceHandle::new(video_device_path)?)) })
     }
 
