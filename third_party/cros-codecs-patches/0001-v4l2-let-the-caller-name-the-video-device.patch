 impl<V: VideoFrame> DeviceHandle<V> {
-    fn new() -> Result<Self, NewStatelessDecoderError> {
-        let devices = enumerate_devices();
+    fn new(video_device_path: Option<PathBuf>) -> Result<Self, NewStatelessDecoderError> {
+        // An explicit path skips `enumerate_devices`, which picks the first
+        // /dev/videoN with an output mplane queue and a matching media device
+        // and never checks that it decodes anything. On an RK3399 that is the
+        // hantro encoder rather than rkvdec, and decode fails with
+        // `Unrecoverable decoding error`.
+        let devices = match video_device_path {
+            Some(video_device_path) => {
+                let video_device_config = DeviceConfig::new().non_blocking_dqbuf();
+                let device = VideoDevice::open(&video_device_path, video_device_config)
+                    .map_err(|_| NewStatelessDecoderError::DriverInitialization)?;
+                let media_device_path = find_media_device(Arc::new(device).caps())
+                    .ok_or(NewStatelessDecoderError::DriverInitialization)?;
+                Some((video_device_path, media_device_path))
+            }
+            None => enumerate_devices(),
+        };
         let (video_device_path, media_device_path) = match devices {
             Some(paths) => paths,
             None => return Err(NewStatelessDecoderError::DriverInitialization),
@@ -155,7 +172,19 @@ pub struct V4l2Device<V: VideoFrame> {
 
 impl<V: VideoFrame> V4l2Device<V> {
