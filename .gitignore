target/
.worktrees/
Cargo.lock.bak

# Stray build artifacts and session-recording leftovers
*.rlib
tmux-client-*.log

# Node / web client build output
node_modules/
ghostframe-web-client/dist/

# wasm-pack build artefacts
ghostframe-client-wasm/pkg-node/
ghostframe-client-wasm/pkg-web/

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code session artifacts (local state, never committed)
.claude/

# Tailscale state dirs used by local manual smoke tests
/tmp/ghostframe-ts*

# Ghostbridge build artifacts
ghostbridge/libghostbridge.a
ghostbridge/libghostbridge.h
# `make sync-dist` rsyncs ghostframe-web-client/dist/ to here, because
# //go:embed follows neither symlinks nor `..`. A second copy of the whole
# built SPA -- same `git add -A` hazard as the binary below.
ghostbridge/dist/
# `just ci-local` runs `go build ./...` in ghostbridge/, which drops a
# ~34 MB binary here. Untracked and unignored, it is one `git add -A`
# away from the history.
ghostbridge/ghostbridge
ghostframe-lib/libghostbridge.a
ghostframe-lib/libghostbridge.h
.serena/

# Hand-run hardware probes (tools/hw-probe/Makefile). Compiled binaries and the
# H.264 clip the README tells you to generate next to them.
tools/hw-probe/glprobe
tools/hw-probe/gbmprobe
tools/hw-probe/expbuf_probe
tools/hw-probe/*.h264

# Screenshots dropped in the repo root while debugging a live session.
# One was committed by accident (a 2 MB blob, stripped from history on
# 2026-09-22) because `git add -A` sweeps untracked files. Test fixtures and
# golden images live under */fixtures/ and */golden/ and are unaffected.
Screenshot*.png
