# ATTACH MODE. This daemon captures the session of the user it runs as --
# DISPLAY=:0, the operator's own desktop.
#
# A client that reaches the tailnet endpoint therefore gets that desktop:
# their files, their browser sessions, their sudo. Not a sandboxed guest
# session as in headless mode. Single-client eviction (M4a) still applies, so
# two clients cannot both attach, but the tailnet is the only boundary.
#
# If that is not what you want, use --mode headless.

[Unit]
Description=Ghostframe capture + transport daemon
After=graphical-session.target
# Restart with session: keeps the capture pipeline active for the lifetime
# of the operator's desktop.
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=TS_HOSTNAME=%H-ghostframe
Environment=TS_STATE_DIR=%h/.local/share/ghostframe/ts-state
# Use the X-protocol capture path, not DRM.
#
# NOTE this comment was rewritten for attach mode. The headless unit's
# version explains that DRM capture reads the host's real scanout "instead
# of the guest Xorg on DISPLAY=:1" -- a content mismatch. That specific
# reasoning does NOT apply here: in attach mode the captured session IS the
# physical display, so a DRM read would see the right pixels.
#
# It stays set anyway, for a different and narrower reason: the DRM paths
# need privileges this daemon does not have. The zero-copy writeback path
# needs an atomic commit, which needs DRM master -- and X holds it. That
# leaves the modesetting-FB fallback, whose CPU-mmap read might well work
# here, but nobody has tried it.
#
# So this is the known-working path, not a proven-optimal one. Whether DRM
# capture is viable in attach mode is genuinely unexplored; if someone
# measures it, this comment should be replaced by that measurement rather
# than by another assumption.
Environment=GHOSTFRAME_X11_CAPTURE_ONLY=1
# Caps how large a remote client may resize this session. In attach mode the
# session IS the physical display, which a KVM may be capturing as the
# machine's recovery view -- an unclamped client could set a mode that view
# cannot capture, removing the recovery path exactly when it is wanted.
# Substituted by install.sh; "none" disables the clamp.
Environment=GHOSTFRAME_ATTACH_MAX_RESOLUTION=__MAX_RESOLUTION__
# X11 readiness is gated inside the daemon (wait_for_x11 in main.rs): the
# daemon blocks on x11rb::connect for up to 10s before bringing up tsnet,
# and exits with a clear journal message on timeout.
ExecStart=/usr/local/bin/ghostframe-xdaemon
Restart=on-failure
RestartSec=2
SyslogIdentifier=ghostframe-xdaemon

[Install]
WantedBy=graphical-session.target
