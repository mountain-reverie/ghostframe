 /// Enumerate V4L2 (video and media) devices on the system.
 pub fn enumerate_devices() -> Option<(PathBuf, PathBuf)> {
+    // PATCH (upstreamable): honour an explicit device override.
+    //
+    // The scan below returns the FIRST /dev/videoN that has an output mplane
+    // queue and a matching media device, with no check that the device can
+    // decode the codec in question. On an RK3399 that picks /dev/video0 --
+    // the hantro ENCODER -- and H.264 decode fails, even though rkvdec on
+    // /dev/video3 handles it fine. `C2V4L2DecoderOptions::video_device_path`
+    // exists for this but is marked "currently unused".
+    if let Ok(path) = std::env::var("CROS_CODECS_V4L2_DEVICE") {
+        let video_device_path = PathBuf::from(&path);
+        let video_device_config = DeviceConfig::new().non_blocking_dqbuf();
+        if let Ok(device) = VideoDevice::open(&video_device_path, video_device_config) {
+            let device = Arc::new(device);
+            if let Some(media_device_path) = find_media_device(device.caps()) {
+                log::info!(
+                    "CROS_CODECS_V4L2_DEVICE override: video {:?}, media {:?}",
+                    video_device_path,
+                    media_device_path
+                );
+                return Some((video_device_path, media_device_path));
+            }
+        }
+        log::warn!("CROS_CODECS_V4L2_DEVICE={path} unusable; falling back to scan");
+    }
